{% extends 'base.html.twig' %}
{% block title %}Images{% endblock %}
{% block body %}
<div id="images" class="container">
    <div class="row">
        <div class="col-xs-12 col-md-10 col-md-offset-1">
            <header class="page-header-block">
                <span class="eyebrow">Admin</span>
                <h1>Images</h1>
            </header>

            <div class="card form-card">
                {{ form(form) }}
            </div>

            <div class="table-wrap" style="margin-top:24px" data-reveal>
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">File</th>
                            <th scope="col" class="num">Views</th>
                            <th scope="col" class="num">Likes</th>
                            <th scope="col" class="num">Downloads</th>
                            <th scope="col">Category</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for image in images %}
                            <tr>
                                <th scope="row">{{ image.id }}</th>
                                <td>
                                    <div class="media thumb is-loading">
                                        <img src="{{ asset('images/index/gallery/' ~ image.file) }}" alt="{{ image.file }}" loading="lazy">
                                    </div>
                                </td>
                                <td class="num">{{ image.numViews }}</td>
                                <td class="num">{{ image.numLikes }}</td>
                                <td class="num">{{ image.numDownloads }}</td>
                                <td><span class="pill">{{ image.category.name }}</span></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="text-muted">No images yet.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
