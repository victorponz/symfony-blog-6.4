<div class="col-xs-12 col-sm-6 col-md-3" style="--i: {{ loop.index0 }}">
    <figure class="tile" style="margin:0">
        <div class="media is-loading">
            <img src="{{ asset('images/index/portfolio/' ~ image.file) }}" alt="Picture {{ image.id }}" loading="lazy">
        </div>
        <figcaption class="tile-overlay glass">
            <ul class="tile-actions">
                <li><a class="gallery" href="{{ asset('images/index/gallery/' ~ image.file) }}" data-toggle="tooltip" title="Quick view" aria-label="Quick view"><i class="fa fa-expand"></i></a></li>
                <li><a class="js-like" href="#" data-toggle="tooltip" title="Like" aria-label="Like"><i class="fa fa-heart"></i></a></li>
                <li><a href="{{ asset('images/index/gallery/' ~ image.file) }}" download data-toggle="tooltip" title="Download" aria-label="Download"><i class="fa fa-download"></i></a></li>
            </ul>
            <ul class="tile-stats">
                <li><i class="fa fa-eye"></i>{{ image.numViews }}</li>
                <li><i class="fa fa-heart"></i><span class="js-like-count">{{ image.numLikes }}</span></li>
                <li><i class="fa fa-download"></i>{{ image.numDownloads }}</li>
            </ul>
        </figcaption>
    </figure>
</div>
