{% set route = app.request.attributes.get('_route') %}
<!-- Navigation Bar -->
<nav class="navbar navbar-fixed-top site-nav">
    <div class="container">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#menu" aria-expanded="false" aria-controls="menu">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            <a class="navbar-brand" href="{{ path('index') }}">
                <span class="brand-mark"><i class="fa fa-camera"></i></span>
                <span>PHOTO</span>
            </a>
        </div>
        <div class="collapse navbar-collapse navbar-right" id="menu">
            <ul class="nav navbar-nav">
                <li class="{{ route == 'index' ? 'active' }}"><a href="{{ path('index') }}"><i class="fa fa-home"></i> Home</a></li>
                <li class="{{ route == 'about' ? 'active' }}"><a href="{{ path('about') }}"><i class="fa fa-bookmark"></i> About</a></li>
                <li class="{{ route in ['blog', 'blog_buscar', 'single_post'] ? 'active' }}"><a href="{{ path('blog') }}"><i class="fa fa-file-text"></i> Blog</a></li>
                <li class="{{ route == 'contact' ? 'active' }}"><a href="{{ path('contact') }}"><i class="fa fa-envelope"></i> Contact</a></li>
                {% if app.user %}
                    <li class="{{ route == 'new_post' ? 'active' }}"><a href="{{ path('new_post') }}"><i class="fa fa-plus"></i> New post</a></li>
                    <li><a href="{{ path('app_logout') }}"><i class="fa fa-sign-out"></i> {{ app.user.name }} · Logout</a></li>
                {% else %}
                    <li class="{{ route == 'app_login' ? 'active' }}"><a href="{{ path('app_login') }}"><i class="fa fa-sign-in"></i> Login</a></li>
                    <li class="nav-cta"><a href="{{ path('app_register') }}"><i class="fa fa-user-plus"></i> Register</a></li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
<!-- End of Navigation Bar -->
